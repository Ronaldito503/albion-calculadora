<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Albion Refine Tool</title>
    <link rel="manifest" href="data:application/manifest+json;utf-8,%7B%22name%22%3A%22Albion%20Refine%22%2C%22short_name%22%3A%22Refine%22%2C%22start_url%22%3A%22.%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%23121212%22%2C%22theme_color%22%3A%22%231f1f1f%22%7D">
    <style>
        :root {
            --bg-color: #121212;
            --card-bg: #1e1e1e;
            --accent: #bb86fc;
            --text-main: #e0e0e0;
            --text-sub: #a0a0a0;
            --green: #4caf50;
            --red: #f44336;
            --border: #333;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 15px;
            display: flex;
            justify-content: center;
        }

        .container {
            max-width: 500px;
            width: 100%;
        }

        h1 {
            text-align: center;
            font-size: 1.5rem;
            color: var(--accent);
            margin-bottom: 20px;
        }

        .card {
            background-color: var(--card-bg);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid var(--border);
        }

        /* Contenedor del Icono Oficial del Juego */
        .item-preview-box {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            background: #181818;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid var(--border);
            margin-bottom: 15px;
        }

        .item-preview-box img {
            width: 70px;
            height: 70px;
            object-fit: contain;
        }

        .form-group {
            margin-bottom: 12px;
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 0.85rem;
            color: var(--text-sub);
            margin-bottom: 5px;
        }

        select, input {
            background-color: #2b2b2b;
            color: #fff;
            border: 1px solid var(--border);
            padding: 10px;
            border-radius: 5px;
            font-size: 0.95rem;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 10px;
        }

        button {
            background-color: var(--accent);
            color: #000;
            font-weight: bold;
            border: none;
            padding: 12px;
            border-radius: 5px;
            width: 100%;
            font-size: 1rem;
            cursor: pointer;
            margin-top: 15px;
        }

        .result-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid var(--border);
        }

        .result-item:last-child {
            border-bottom: none;
        }

        .profit-pos { color: var(--green); font-weight: bold; }
        .profit-neg { color: var(--red); font-weight: bold; }
    </style>
</head>
<body>

<div class="container">
    <h1>Calculadora de Refinado (Sin Ads)</h1>

    <div class="card">
        <!-- Vista previa dinámica con render oficial de Albion -->
        <div class="item-preview-box">
            <div style="text-align: center;">
                <span style="font-size: 0.75rem; color: var(--text-sub); display: block;">Materia Prima</span>
                <img id="rawImg" src="https://render.albiononline.com/v1/item/T4_HIDE.png" alt="Materia Prima">
            </div>
            <span style="font-size: 1.5rem; color: var(--accent);">➔</span>
            <div style="text-align: center;">
                <span style="font-size: 0.75rem; color: var(--text-sub); display: block;">Procesado</span>
                <img id="refinedImg" src="https://render.albiononline.com/v1/item/T4_LEATHER.png" alt="Recurso Refinado">
            </div>
        </div>

        <div class="form-group">
            <label for="resource">Recurso</label>
            <select id="resource" onchange="updateIcons()">
                <option value="LEATHER">Cuero (Piel / Hide)</option>
                <option value="CLOTH">Tela (Fibra / Fiber)</option>
                <option value="PLANKS">Tablas (Madera / Wood)</option>
                <option value="METALBAR">Barras de Metal (Mineral / Ore)</option>
                <option value="STONEBLOCK">Bloques de Piedra (Piedra / Stone)</option>
            </select>
        </div>

        <div class="grid-2">
            <div class="form-group">
                <label for="tier">Tier</label>
                <select id="tier" onchange="updateIcons()">
                    <option value="T4">T4</option>
                    <option value="T5">T5</option>
                    <option value="T6">T6</option>
                    <option value="T7">T7</option>
                    <option value="T8">T8</option>
                </select>
            </div>
            <div class="form-group">
                <label for="enchant">Encantamiento</label>
                <select id="enchant" onchange="updateIcons()">
                    <option value="0">.0</option>
                    <option value="1">.1</option>
                    <option value="2">.2</option>
                    <option value="3">.3</option>
                    <option value="4">.4</option>
                </select>
            </div>
        </div>

        <div class="grid-2">
            <div class="form-group">
                <label for="buyCity">Ciudad Comprar Materia</label>
                <select id="buyCity">
                    <option value="Martlock">Martlock</option>
                    <option value="Bridgewatch">Bridgewatch</option>
                    <option value="Lymhurst">Lymhurst</option>
                    <option value="Fort Sterling">Fort Sterling</option>
                    <option value="Thetford">Thetford</option>
                    <option value="Caerleon">Caerleon</option>
                </select>
            </div>
            <div class="form-group">
                <label for="sellCity">Ciudad Vender Refinado</label>
                <select id="sellCity">
                    <option value="Lymhurst">Lymhurst</option>
                    <option value="Bridgewatch">Bridgewatch</option>
                    <option value="Martlock">Martlock</option>
                    <option value="Fort Sterling">Fort Sterling</option>
                    <option value="Thetford">Thetford</option>
                    <option value="Caerleon">Caerleon</option>
                </select>
            </div>
        </div>

        <div class="grid-2">
            <div class="form-group">
                <label for="rrf">Retorno % (RRF)</label>
                <input type="number" id="rrf" value="36.7" step="0.1">
            </div>
            <div class="form-group">
                <label for="tax">Tasa Estación (Usage Fee)</label>
                <input type="number" id="tax" value="500">
            </div>
        </div>

        <div class="checkbox-group">
            <label for="premium">¿Tienes Premium? (4% Impuesto)</label>
            <input type="checkbox" id="premium" checked>
        </div>

        <button onclick="calculateRefining()">Calcular Ganancia</button>
    </div>

    <div class="card" id="resultsCard" style="display: none;">
        <h3>Resultados por Unidad</h3>
        <div class="result-item">
            <span>Costo Materia Prima:</span>
            <span id="costRaw">0 Silver</span>
        </div>
        <div class="result-item">
            <span>Tasa de Estación:</span>
            <span id="costStation">0 Silver</span>
        </div>
        <div class="result-item">
            <span>Precio Venta Estimado:</span>
            <span id="sellPrice">0 Silver</span>
        </div>
        <div class="result-item">
            <span>Impuesto de Mercado:</span>
            <span id="marketTax">0 Silver</span>
        </div>
        <hr style="border-color: var(--border);">
        <div class="result-item">
            <span><strong>Ganancia Neta / Unidad:</strong></span>
            <span id="netProfit" class="profit-pos">0 Silver</span>
        </div>
    </div>
</div>

<script>
    const rawMap = {
        'LEATHER': 'HIDE',
        'CLOTH': 'FIBER',
        'PLANKS': 'WOOD',
        'METALBAR': 'ORE',
        'STONEBLOCK': 'ROCK'
    };

    function updateIcons() {
        const resource = document.getElementById('resource').value;
        const tier = document.getElementById('tier').value;
        const enchant = document.getElementById('enchant').value;

        const rawType = rawMap[resource];
        const enchantSuffix = enchant !== "0" ? `@${enchant}` : "";

        const rawItemId = `${tier}_${rawType}${enchantSuffix}`;
        const refinedItemId = `${tier}_${resource}${enchantSuffix}`;

        document.getElementById('rawImg').src = `https://render.albiononline.com/v1/item/${rawItemId}.png`;
        document.getElementById('refinedImg').src = `https://render.albiononline.com/v1/item/${refinedItemId}.png`;
    }

    async function calculateRefining() {
        const resource = document.getElementById('resource').value;
        const tier = document.getElementById('tier').value;
        const enchant = document.getElementById('enchant').value;
        const buyCity = document.getElementById('buyCity').value;
        const sellCity = document.getElementById('sellCity').value;
        const rrf = parseFloat(document.getElementById('rrf').value) / 100;
        const stationFee = parseFloat(document.getElementById('tax').value);
        const isPremium = document.getElementById('premium').checked;

        const rawType = rawMap[resource];
        const enchantSuffix = enchant !== "0" ? `@${enchant}` : "";
        
        const rawItemId = `${tier}_${rawType}${enchantSuffix}`;
        const refinedItemId = `${tier}_${resource}${enchantSuffix}`;

        try {
            const cities = `${buyCity},${sellCity}`;
            const url = `https://www.albion-online-data.com/api/v2/stats/prices/${rawItemId},${refinedItemId}.json?locations=${cities}`;
            
            const response = await fetch(url);
            const data = await response.json();

            const rawPrice = getBestPrice(data, rawItemId, buyCity, 'sell_price_min');
            const refinedPrice = getBestPrice(data, refinedItemId, sellCity, 'sell_price_min');

            if (!rawPrice || !refinedPrice) {
                alert("No hay datos de precios recientes en la API para esta selección.");
                return;
            }

            const rawQuantityNeeded = 2; 
            const rawCostEffective = (rawPrice * rawQuantityNeeded) * (1 - rrf);
            const stationCost = (stationFee * 1.12);

            const marketTaxRate = isPremium ? 0.065 : 0.105;
            const taxAmount = refinedPrice * marketTaxRate;
            
            const totalCost = rawCostEffective + stationCost;
            const netProfit = (refinedPrice - taxAmount) - totalCost;

            document.getElementById('costRaw').innerText = `${Math.round(rawCostEffective)} Silver`;
            document.getElementById('costStation').innerText = `${Math.round(stationCost)} Silver`;
            document.getElementById('sellPrice').innerText = `${refinedPrice} Silver`;
            document.getElementById('marketTax').innerText = `${Math.round(taxAmount)} Silver`;
            
            const profitElem = document.getElementById('netProfit');
            profitElem.innerText = `${Math.round(netProfit)} Silver`;
            profitElem.className = netProfit >= 0 ? "profit-pos" : "profit-neg";

            document.getElementById('resultsCard').style.display = 'block';

        } catch (error) {
            console.error(error);
            alert("Error al conectar con la API de precios.");
        }
    }

    function getBestPrice(data, itemId, city, priceKey) {
        const itemData = data.find(d => d.item_id === itemId && d.city === city);
        return itemData ? itemData[priceKey] : 0;
    }
</script>
</body>
</html>
